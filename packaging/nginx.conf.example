# ---------------------------------------------------------------------------
# /etc/nginx/nginx.conf — example config with geosite + proxy_interface
#
# This file ships as /etc/nginx/nginx.conf.example alongside the package.
# To use it: cp /etc/nginx/nginx.conf.example /etc/nginx/nginx.conf
#
# Requires:
#   - nginx-geosite package (cddeppe nginx fork)
#   - dlc.dat at /usr/local/etc/xray/domains/dlc.dat (auto-installed)
#   - CAP_NET_RAW on the binary (auto-set by the package postinst)
#
# Mirror of the original Xray routing config:
#   geosite:amazon / hulu / disney / netflix → wireguard (iface "ak")
#   intuit.com / *.intuit.com                → wireguard (iface "ak")
#   dns.controld.com                         → direct
#   everything else                          → direct, original port
# ---------------------------------------------------------------------------

user www-data;
worker_processes auto;
worker_rlimit_nofile 200000;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 65536;
    use epoll;
    multi_accept on;
}

http {
    log_format basic '$remote_addr [$time_local] '
                     '--$server_name $server_port --serveraddr:$server_addr '
                     '--$ssl_server_name $ssl_server_name';

    access_log /var/log/nginx/access.log basic buffer=256k flush=5s;

    keepalive_requests 1000;
    keepalive_timeout 75s;

    # Example: HTTP → HTTPS redirect (edit IPs to match your server).
    # A comma-separated address list expands to one listening socket per
    # address; the directive's options apply to every address in the list.
    # server {
    #     listen 82.21.4.42:80, [2a0e:7d43:0:1::1]:80
    #            bind reuseport so_keepalive=on;
    #     http2 on;
    #     return 301 https://$host$request_uri;
    # }
}

stream {
    # -------------------------------------------------------------------
    # 1. Load the geosite database.
    #    Auto-downloaded by the package postinst to:
    #      /usr/local/etc/xray/domains/dlc.dat
    #    Auto-refreshed weekly by /etc/cron.weekly/refresh-geosite
    # -------------------------------------------------------------------
    geosite_load /usr/local/etc/xray/domains/dlc.dat;

    #    Only load the categories we route on — saves ~150 MB of RAM
    #    compared to loading all 250+ categories in the file.
    geosite_filter amazon hulu disney netflix;

    #    Optional: tune hash tables. Defaults (256 / 16384) work for the
    #    full v2fly dlc.dat. If you see "could not build geosite_domain_hash"
    #    in error.log, double bucket_size.
    # geosite_hash_bucket_size 512;
    # geosite_hash_max_size 32768;

    log_format basic '$remote_addr [$time_local] '
                     '--$ssl_alpn_protocol $ssl_preread_server_name $server_port '
                     '--serveraddr:$server_addr --$ssl_server_name $hostname '
                     'geosite=$geosite_category iface=$final_iface';

    access_log /var/log/nginx/nginx-access.log basic buffer=256k flush=5s;

    # -------------------------------------------------------------------
    # 2. Backend selection (edit to match your setup)
    # -------------------------------------------------------------------
    map $ssl_preread_server_name $target_backend {
        # nas.deppe.cc                      "$ssl_preread_server_name:3064";
        default                           "$ssl_preread_server_name:$server_port";
    }

    # -------------------------------------------------------------------
    # 3. Geosite → egress interface (Xray outboundTag equivalent)
    #    Multiple keys may share one value in a single entry.
    # -------------------------------------------------------------------
    map $geosite_category $geosite_iface {
        default                    off;
        amazon hulu disney netflix ak;     # wg-quick interface name
    }

    # -------------------------------------------------------------------
    # 4. Bare-domain overrides (Xray "domain:" rules)
    #    Regex keys can be combined the same way.
    # -------------------------------------------------------------------
    map $ssl_preread_server_name $domain_override {
        default                                            $geosite_iface;
        ~*^(.+\.)?intuit\.com$ ~*^(.+\.)?intuitcdn\.net$  ak;
        ~*^dns\.controld\.com$                             off;   # direct
    }

    # -------------------------------------------------------------------
    # 5. Final egress decision
    # -------------------------------------------------------------------
    map $domain_override $final_iface {
        ""      $geosite_iface;
        default $domain_override;
    }

    # -------------------------------------------------------------------
    # 6. Shared server defaults — set once at stream{} level, inherited
    #    by every server{} below (no need to repeat them per server).
    # -------------------------------------------------------------------
    tcp_nodelay             on;
    preread_buffer_size     16k;
    preread_timeout         30s;
    proxy_timeout           4h;
    proxy_connect_timeout   30s;
    proxy_buffer_size       2048k;
    proxy_socket_keepalive  on;
    proxy_ssl_session_reuse off;

    # default resolver for all servers (a server may override)
    resolver 127.0.0.1 [::1] ipv4=on ipv6=on valid=30s;

    # -------------------------------------------------------------------
    # 7. Main TLS-passthrough proxy (edit IPs to match your server)
    #    Only the per-server specifics live here: listen address list,
    #    ssl_preread, proxy_pass — the shared settings are inherited
    #    from the stream{} block above.
    # -------------------------------------------------------------------
    server {
        # Multiple specific addresses in one directive (one socket each,
        # shared options — same as writing them on separate lines):
        # listen 82.21.4.42:443, [2a0e:7d43:0:1::1]:443 bind reuseport so_keepalive=on rcvbuf=1024m sndbuf=512m fastopen=256;
        listen 0.0.0.0:443 bind reuseport so_keepalive=on fastopen=256;
        listen [::]:443 bind reuseport so_keepalive=on fastopen=256;

        ssl_preread on;

        # Bind upstream socket to chosen interface via SO_BINDTODEVICE.
        # Empty / "off" → no bind (use main routing table).
        proxy_interface $final_iface;

        proxy_pass $target_backend;
    }

    # -------------------------------------------------------------------
    # 8. Example NAS port forwards (uncomment + edit to match your setup)
    #    A variable default passes unknown ports through unchanged, so
    #    only the remapped ports need explicit entries.
    # -------------------------------------------------------------------
    # map $server_port $nas_backend {
    #     default   "nas.example.com:$server_port";
    #     3390      "nas.example.com:3389";
    #     32410     "nas.example.com:32400";
    # }
    #
    # server {
    #     listen 82.21.4.42:3064, 82.21.4.42:3066, [2a0e:7d43:0:1::1]:3064 bind reuseport so_keepalive=off fastopen=256;
    #     proxy_pass $nas_backend;    # resolver inherited from stream{}
    # }
}
