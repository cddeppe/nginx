[Unit]
Description=nginx (cddeppe fork — geosite + proxy_interface)
Documentation=https://github.com/cddeppe/nginx/blob/master/GEOSITE.md
After=network-online.target network.target remote-fs.target
Wants=network-online.target
# Restart on failure — boot race condition protection.
# These two directives MUST be in [Unit], not [Service] (systemd requirement).
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=forking
PIDFile=/run/nginx.pid
ExecStartPre=/usr/sbin/nginx -t -q -c /etc/nginx/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/nginx/nginx.conf
ExecReload=/usr/sbin/nginx -s reload
ExecStop=/bin/kill -s TERM $MAINPID
PrivateTmp=true

# Grant capabilities needed for:
# - binding to ports < 1024 (CAP_NET_BIND_SERVICE for ports 80, 443)
# - SO_BINDTODEVICE in proxy_interface (CAP_NET_RAW)
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE

# Give nginx time to parse dlc.dat (~2.3 MB) before systemd gives up.
TimeoutStartSec=30
# Graceful shutdown can take a while with long-lived connections.
TimeoutStopSec=60
# KillMode=mixed: systemd sends SIGTERM to main, then SIGKILL to workers
# after TimeoutStopSec. Prevents orphan workers holding ports.
KillMode=mixed
KillSignal=TERM

# Restart on failure — covers boot race condition where secondary IPs
# aren't bound yet when nginx starts.
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
