[Unit]
Description=nginx (cddeppe fork — geosite + proxy_interface)
Documentation=https://github.com/cddeppe/nginx/blob/master/GEOSITE.md
After=network.target network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/run/nginx.pid
ExecStartPre=/usr/sbin/nginx -t -q -c /etc/nginx/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/nginx/nginx.conf
ExecReload=/usr/sbin/nginx -s reload
ExecStop=/bin/kill -s QUIT $MAINPID
PrivateTmp=true

# Grant capabilities needed for:
# - binding to ports < 1024 (CAP_NET_BIND_SERVICE for ports 80, 443)
# - SO_BINDTODEVICE in proxy_interface (CAP_NET_RAW)
#
# Do NOT set CapabilityBoundingSet here — that would strip CAP_DAC_OVERRIDE
# (which root needs to open log files) and CAP_SETUID/CAP_SETGID (which
# nginx needs to switch to the worker user). AmbientCapabilities alone
# is enough to grant the two extra caps we need on top of root's defaults.
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE

# Give nginx time to parse dlc.dat (~2.3 MB) before systemd gives up.
# First start after install can take 1-2 seconds while geosite hashes build.
TimeoutStartSec=30
TimeoutStopSec=10
KillMode=process
KillSignal=QUIT

[Install]
WantedBy=multi-user.target
